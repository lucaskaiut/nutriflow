# URL da API NutriFlow (sem barra final). No emulador Android use http://10.0.2.2:8090/api;
# em aparelho físico, o IP da sua máquina na rede (ex.: http://192.168.0.10:8090/api).
# Em produção, SEMPRE https://.
EXPO_PUBLIC_API_URL=http://localhost:8090/api

# Login com Google (opcional). Client IDs OAuth PÚBLICOS por plataforma (não são segredos).
# Também configure os mesmos IDs em GOOGLE_CLIENT_IDS na API. Vazio = botão do Google oculto.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
